{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "concurrency": 4,
  "ignoreStatic": true,
  "mutate": [
    "src/core/theory/musicTheory.ts",
    "src/core/engine/PracticeEngine.ts",
    "src/core/engine/TrainingSessionCoordinator.ts"
  ],
  "ignorePatterns": [
    "tsconfig.json",
    "eslint.config.js",
    "dev-dist/**",
    "dist/**",
    ".stryker-tmp/**"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  }
}
