{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "concurrency": 2,
  "ignoreStatic": true,
  "mutate": [
    "src/core/theory/**/*.ts",
    "src/core/engine/**/*.ts"
  ],
  "ignorePatterns": [
    "tsconfig.json",
    ".stryker-tmp/**"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 65
  }
}
